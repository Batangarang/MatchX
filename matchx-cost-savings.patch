     const age = (new Date() - new Date(existing.generatedAt)) / 60000;
-    return age < FRESHNESS_MINUTES;
+    const limit = isDivisionMatchdayToday() ? FRESHNESS_MINUTES_MATCHDAY : FRESHNESS_MINUTES_QUIET;
+    return age < limit;
   } catch {
     return false;
   }
