+    // Bulk-trigger every workflow that produces AI-written content (Fan
+    // Briefing, Division Preview, Division Recap — flagged `ai: true` in
+    // WORKFLOWS above) with manual=true, so each one bypasses its own
+    // once-per-day/once-per-period throttle. Useful after a gap of not
+    // running things (e.g. API credits ran out) instead of clicking "Run
+    // now" on each one separately. Matchday-only workflows (Matchday Live,
+    // Division Scores) are deliberately left out — forcing those outside an
+    // actual match window has nothing to analyse and just burns calls.
+    async function refreshAllAI(btnEl) {
+      const token = getGhToken();
+      if (!token) return;
+
+      const targets = WORKFLOWS.filter(w => w.ai);
+      btnEl.disabled = true;
+
+      for (let i = 0; i < targets.length; i++) {
+        const wf = targets[i];
+        btnEl.textContent = `Triggering ${wf.name}… (${i + 1}/${targets.length})`;
+        try {
+          const res = await dispatchWorkflow(wf.file, token);
+          if (res.status !== 204) {
+            if (res.status === 401 || res.status === 403 || res.status === 404) {
+              btnEl.textContent = 'Failed — check token';
+              localStorage.removeItem('matchx_gh_token');
+              updateTokenStatus();
+              btnEl.disabled = false;
+              return;
+            }
+            console.warn(`${wf.name} failed to trigger: ${res.status}`);
+          }
+        } catch (err) {
+          console.warn(`${wf.name} failed to trigger:`, err);
+        }
+        // Small gap between dispatches so GitHub doesn't secondary-rate-limit rapid POSTs.
+        if (i < targets.length - 1) await new Promise(r => setTimeout(r, 1500));
+      }
+
+      btnEl.textContent = `Triggered all ${targets.length} ✓`;
+      setTimeout(() => loadWorkflows(), 3000);
+      setTimeout(() => { btnEl.textContent = 'Refresh all AI content'; btnEl.disabled = false; }, 4000);
+    }
+
